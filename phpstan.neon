parameters:
    level: 6
    dynamicConstantNames:
        - WC_VERSION
        - WP_DEBUG
    bootstrapFiles:
        - bin/phpstan-bootstrap.php
    stubFiles:
        - bin/stubs/wordpress.stub
        - bin/stubs/woocommerce.stub
    paths:
        - src
        - uninstall.php
    scanFiles:
        - carticy-ai-checkout-for-woocommerce.php
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - bin/stubs/stripe.stub
    tmpDir: .cache/phpstan
    parallel:
        maximumNumberOfProcesses: 4
